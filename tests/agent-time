#!/usr/bin/env python3
"""Check hooks/agent_time.py against a fake forge: blocks, logging once, codes, no setting or token.

  tests/agent-time

Serves a fake GitLab on a loopback port and keeps config, state and repos under a
temporary directory, so nothing real is read or written. Exits non-zero on a failure.
"""
import http.server
import json
import os
import sys
import tempfile
import threading
import unittest
import urllib.parse

if "-h" in sys.argv or "--help" in sys.argv:
    print(__doc__.strip())
    sys.exit(0)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
import agent_time as at  # noqa: E402

T0 = 1_700_000_000


class Fake(http.server.BaseHTTPRequestHandler):
    tickets = {}   # code -> (id, iid)
    logged = []    # graphql inputs received
    down = False   # answer 500 to everything

    def log_message(self, *a):
        pass

    def reply(self, status, body):
        self.send_response(status)
        self.end_headers()
        self.wfile.write(json.dumps(body).encode())

    def do_GET(self):
        if Fake.down:
            return self.reply(500, {})
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        code = [l for l in q["labels"][0].split(",") if l.startswith("code:")][0][5:]
        t = Fake.tickets.get(code)
        self.reply(200, [{"id": t[0], "iid": t[1]}] if t else [])

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if Fake.down:
            return self.reply(500, {})
        Fake.logged.append((self.headers["PRIVATE-TOKEN"], body["variables"]["input"]))
        self.reply(200, {"data": {"timelogCreate": {"timelog": {"id": "1"}, "errors": []}}})


class Case(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.server = http.server.HTTPServer(("127.0.0.1", 0), Fake)
        threading.Thread(target=cls.server.serve_forever, daemon=True).start()
        cls.url = "http://127.0.0.1:%d" % cls.server.server_port

    @classmethod
    def tearDownClass(cls):
        cls.server.shutdown()

    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        t = self.tmp.name
        os.environ["AGENT_TIME_CONFIG_DIR"] = t + "/config"
        os.environ["AGENT_TIME_STATE_DIR"] = t + "/state"
        os.makedirs(t + "/config")
        self.repo = t + "/repo"
        os.makedirs(self.repo)
        Fake.tickets, Fake.logged, Fake.down = {"25050.9283": (900, 3), "11111.1": (901, 4)}, [], False
        self.setting(code="25050.9283")
        self.token("g-p", "secret-token")

    def tearDown(self):
        self.tmp.cleanup()

    def setting(self, **over):
        s = {"forge": self.url, "project": "g/p", "code": "25050.9283", **over}
        with open(self.repo + "/.agent-time.json", "w") as f:
            json.dump(s, f)

    def token(self, name, value):
        with open("%s/config/%s.token" % (self.tmp.name, name), "w") as f:
            f.write(value + "\n")

    def event(self, name, sid="s1", cwd=None, at_time=T0):
        at.hook({"session_id": sid, "cwd": cwd or self.repo, "hook_event_name": name},
                now=at_time, flush_in_child=False)

    def state_files(self):
        d = self.tmp.name + "/state"
        return os.listdir(d) if os.path.isdir(d) else []

    def test_gap_over_30_minutes_splits(self):
        self.assertEqual(at.blocks([0, 1800, 1800 + 1801]), [(0, 1800), (3601, 3601)])

    def test_gap_of_exactly_30_minutes_does_not_split(self):
        self.assertEqual(at.blocks([0, 600, 600 + 1800]), [(0, 2400)])

    def test_session_end_logs_blocks_with_note_and_token(self):
        for t in (0, 100, 5000, 5300):
            self.event("UserPromptSubmit", at_time=T0 + t)
        self.event("SessionEnd", at_time=T0 + 6000)
        self.assertEqual([(i["timeSpent"], i["issuableId"]) for _, i in Fake.logged],
                         [("100s", "gid://gitlab/Issue/900"), ("300s", "gid://gitlab/Issue/900")])
        self.assertEqual({tok for tok, _ in Fake.logged}, {"secret-token"})
        self.assertIn("agent time", Fake.logged[0][1]["summary"])
        self.assertIn("s1", Fake.logged[0][1]["summary"])

    def test_logged_block_is_not_logged_again(self):
        self.event("UserPromptSubmit", at_time=T0)
        self.event("Stop", at_time=T0 + 60)
        self.event("SessionEnd", at_time=T0 + 70)
        self.event("SessionStart", sid="s2", at_time=T0 + 99999)
        self.event("SessionEnd", sid="s2", at_time=T0 + 100000)
        self.assertEqual(len(Fake.logged), 1)

    def test_unlogged_block_is_logged_at_next_session_start_once(self):
        self.event("UserPromptSubmit", at_time=T0)
        self.event("Stop", at_time=T0 + 60)
        Fake.down = True
        self.event("SessionEnd", at_time=T0 + 70)
        self.assertEqual(Fake.logged, [])
        Fake.down = False
        self.event("SessionStart", sid="s2", at_time=T0 + 99999)
        self.assertEqual(len(Fake.logged), 1)
        self.event("SessionEnd", sid="s2", at_time=T0 + 100000)
        self.assertEqual(len(Fake.logged), 1)

    def test_a_session_that_never_ended_is_logged_only_once_its_block_is_over(self):
        self.event("UserPromptSubmit", at_time=T0)
        self.event("Stop", at_time=T0 + 60)
        self.event("SessionStart", sid="s2", at_time=T0 + 120)  # s1 may still be active
        self.assertEqual(Fake.logged, [])
        self.event("SessionStart", sid="s3", at_time=T0 + 60 + 1801)
        self.assertEqual(len(Fake.logged), 1)

    def worktree_slice(self, code_line):
        wt = self.repo + "/.claude/worktrees/fx/001-a"
        os.makedirs(wt + "/.efforts/fx")
        with open(wt + "/.efforts/fx/001-a.md", "w") as f:
            f.write("## a\n\n**Status:** ready-for-agent\n%s\n" % code_line)
        return wt

    def run_session(self, cwd):
        self.event("UserPromptSubmit", cwd=cwd, at_time=T0)
        self.event("Stop", cwd=cwd, at_time=T0 + 60)
        self.event("SessionEnd", cwd=cwd, at_time=T0 + 70)

    def test_slice_code_picks_its_ticket(self):
        self.run_session(self.worktree_slice("**code:** 11111.1"))
        self.assertEqual([i["issuableId"] for _, i in Fake.logged], ["gid://gitlab/Issue/901"])

    def test_slice_without_code_takes_the_default(self):
        self.run_session(self.worktree_slice("**blocked-by:**"))
        self.assertEqual([i["issuableId"] for _, i in Fake.logged], ["gid://gitlab/Issue/900"])

    def test_other_session_takes_the_default(self):
        self.run_session(self.repo)
        self.assertEqual([i["issuableId"] for _, i in Fake.logged], ["gid://gitlab/Issue/900"])

    def test_code_with_no_ticket_keeps_the_block_and_leaves_a_notice(self):
        self.run_session(self.worktree_slice("**code:** 99999.9"))
        self.assertEqual(Fake.logged, [])
        self.assertIn("s1.json", self.state_files())
        with open(self.tmp.name + "/state/notices") as f:
            self.assertIn("code:99999.9", f.read())

    def test_no_setting_logs_nothing_and_keeps_nothing(self):
        os.remove(self.repo + "/.agent-time.json")
        self.run_session(self.repo)
        self.assertEqual((Fake.logged, self.state_files()), ([], []))

    def test_no_token_logs_nothing(self):
        os.remove(self.tmp.name + "/config/g-p.token")
        self.run_session(self.repo)
        self.assertEqual(Fake.logged, [])

    def test_dry_run_writes_nothing(self):
        self.event("UserPromptSubmit", at_time=T0)
        self.event("Stop", at_time=T0 + 60)
        at.dry_run([self.tmp.name + "/state/s1.json"], T0 + 10**6)
        self.assertEqual(Fake.logged, [])


if __name__ == "__main__":
    unittest.main(argv=[sys.argv[0]])
